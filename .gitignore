__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
build/
dist/
*.sqlite3
# SQLite WAL mode writes -wal and -shm sidecars next to the database.
# They are transient journal state: committing them bloats the repo and a
# stale WAL against a different database file can corrupt a checkout.
*.sqlite3-*
*.db
*.db-*
data/*.csv
!data/samples/*.csv
workspace/*/out/*.json
workspace/*/scratch/
workspace/*/log/
workspace/research_plan/
workspace/_shared/*.json
reports/
.DS_Store

# Scan run artefacts. A 108-cell sweep writes one JSON of every qualifying
# strategy per cell plus its work slices; all of it is regenerated by re-running
# the scan, and none of it is source.
workspace/*/cells/
workspace/*/cells.json
workspace/*/slice_*.json
workspace/*/all_rows.json
# Derived from workspace/studies/out/ by aggregate_studies.py on every run.
workspace/studies/merged.json
# Worker run logs, at any nesting depth. The existing workspace/*/log/ rule
# misses workspace/<x>/<worker>/logs/; results are kept, transcripts are not.
workspace/**/logs/

# Desk console: personal account state and its journal database. The risk
# CONFIG is deliberately NOT ignored - it is a shared, reviewable document.
# The account file holds real equity and drawdown history and is not.
desk-account.json
**/desk-account.json
desk/data/

# Desk runtime outputs. The journal database and scratch files are rebuildable
# and stay out of the repository.
data/*.sqlite3
data/*.sqlite3-*
data/futures_agents.sqlite3*

# The bar archive is the exception and IS tracked. Yahoo serves 1-minute bars
# for seven days only, so once a bar rolls off that window it cannot be
# re-fetched from the vendor at any price - and the session container that
# downloaded it is ephemeral. The archive is append-only, so these files grow
# and never rewrite history.
!data/archive/
!data/archive/*.jsonl

# CALL desk live fetch deltas (the 0000-archive symlinks ARE tracked)
workspace/paper/CALL/live/*_fetched_2*.jsonl
workspace/paper/CALL/card_*.png
workspace/paper/CALL/drafts/
